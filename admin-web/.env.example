# ---------------------------------------------------------------------------
# RemitBridge admin console — copy to `.env.local` and fill in. Never commit it.
# ---------------------------------------------------------------------------

# Where the backend listens. Server-only: the browser never talks to the API
# directly, it goes through this app's `/api/backend/*` proxy, so the backend
# address is not baked into a client bundle and CORS is not needed.
REMITBRIDGE_API_URL=http://localhost:4000

# Shown in the header so an operator can see which deployment they are looking
# at before they approve anything. Cosmetic, but the alternative is guessing.
NEXT_PUBLIC_ENVIRONMENT_LABEL=local
