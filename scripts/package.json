{
  "name": "@remitbridge/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "RemitBridge deployment tooling: build, deploy and wire the Soroban contracts",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:contracts": "bash ./build-contracts.sh",
