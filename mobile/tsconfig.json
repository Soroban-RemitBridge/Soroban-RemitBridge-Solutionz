{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    /* Same bar as the other services. The code in this app decides what the
       commit hash is, and a commit hash that does not match the claim code is a
       transfer nobody can ever claim. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
