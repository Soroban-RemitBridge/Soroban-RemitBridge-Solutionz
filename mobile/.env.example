# ---------------------------------------------------------------------------
# RemitBridge mobile — copy to `.env` for local development. Never commit it.
# ---------------------------------------------------------------------------

# Where the backend listens.
#
# This one *is* `EXPO_PUBLIC_*`: unlike the operator console, the app talks to
# the API directly from the device, so the value ends up in the bundle whether
# that is spelled out here or not. It is a URL, not a secret — but nothing else
# secret should ever be added with this prefix.
#
# On a physical device `localhost` is the phone, not your machine. Use the
# machine's LAN address when testing on hardware.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Which Stellar network the app is pointed at. `testnet` is the only sensible
# value for anything that is not a production launch.
EXPO_PUBLIC_STELLAR_NETWORK=testnet
