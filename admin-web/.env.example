[TEMPLATE]
# ---------------------------------------------------------------------------
# RemitBridge admin console — copy to `.env.local` and fill in. Never commit it.
# ---------------------------------------------------------------------------

# Where the backend listens. Server-only: the browser never talks to the API
# directly, it goes through this app's `/api/backend/*` proxy, so the backend
# address is not baked into a client bundle and CORS is not needed.
REMITBRIDGE_API_URL=http://localhost:4000

# Shown in the header so an operator can see which deployment they are looking
# at before they approve anything. Cosmetic, but the alternative is guessing.
NEXT_PUBLIC_ENVIRONMENT_LABEL=local

# --- Operator authentication ----------------------------------------------
# The console refuses every request until both of these are set. That is
# deliberate: an unconfigured gate must not degrade into an open one.
#
# SECRET. HMAC key for signed session cookies. At least 32 characters; generate
# one with `openssl rand -base64 48`. Rotating it signs every operator out.
OPERATOR_SESSION_SECRET=

# How long a session lasts, in minutes. Defaults to 480 (one shift).
OPERATOR_SESSION_TTL_MINUTES=480

# The operator accounts, as a JSON array. There is no user table: until there is
# an identity provider, operators are configuration, which means onboarding one
# is a deploy. Each role is one of `viewer`, `operator`, `admin`:
#
#   viewer    reads every panel, mutates nothing
#   operator  proposes, approves, executes and sweeps float
#   admin     all of the above, plus publishing KYC revocations
#
# Passwords are stored as scrypt hashes, never plaintext. Produce them with:
#
#   node scripts/operator-hash.mjs 'the password'
#
# The script and the verifier share one format (`scrypt$N$r$p$salt$hash`), and
# the test suite asserts they agree — a generator that drifts from the verifier
# locks everyone out.
OPERATOR_ACCOUNTS=[{"email":"you@example.com","name":"Your Name","passwordHash":"scrypt$16384$8$1$...","roles":["admin"]}]
