# ---------------------------------------------------------------------------
# RemitBridge deployment — copy to `.env` and fill in. Never commit `.env`.
#
# This file holds the ANCHOR OPERATOR key. It becomes the admin of all four
# contracts. Treat it as the highest-value secret in the project: it can
# reconfigure compliance thresholds, authorize and slash agents, and unpause the
# network. Use a secret manager in any real deployment, not a file on disk.
# ---------------------------------------------------------------------------

STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Keys -----------------------------------------------------------------
# SECRET. Admin of all four contracts. REQUIRED.
ADMIN_SECRET_KEY=S...

# Public. Receives settlement fees and slashed bond funds. REQUIRED.
TREASURY_PUBLIC_KEY=G...

# Public. The hot key the KYC service uses to publish attestations. Kept
# separate from the admin key so a compromise of the most exposed service does
# not grant control of thresholds or funds. REQUIRED.
ATTESTER_PUBLIC_KEY=G...

# --- Token ----------------------------------------------------------------
# Stellar Asset Contract used for agent bonds and pool float. For testnet,
# create one first:  stellar contract asset deploy --asset <CODE>:<ISSUER>
TOKEN_CONTRACT=C...

# --- Deployment configuration ---------------------------------------------
# Relative to the repository root. Copy testnet.example.json to testnet.json
# and edit; the latter is gitignored because it carries region-specific
# commercial settings.
DEPLOY_CONFIG=scripts/config/testnet.json
