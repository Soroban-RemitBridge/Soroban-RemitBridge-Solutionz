# ---------------------------------------------------------------------------
# RemitBridge backend — copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Postgres holds everything the chain must not: names, documents, screening
# results, travel-rule payloads. Only hashes ever leave this database.
DATABASE_URL=postgresql://remitbridge:remitbridge@localhost:5432/remitbridge?schema=public

# --- Stellar / Soroban ----------------------------------------------------
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Addresses emitted by `scripts/deploy-contracts.ts` into deployed-addresses.json.
CONTRACT_ESCROW=C...
CONTRACT_AGENT_REGISTRY=C...
CONTRACT_COMPLIANCE_HOOK=C...
CONTRACT_LIQUIDITY_POOL=C...

# --- Operator keys --------------------------------------------------------
# SECRETS. Use a secret manager in any real deployment; these two are separated
# deliberately so a compromise of the hot KYC service cannot reconfigure
# compliance thresholds or move network funds.
#
# Attester key: allowed only to publish/revoke attestations.
ATTESTER_SECRET_KEY=S...
# Operator key: can configure corridors, authorize agents, set fees.
OPERATOR_SECRET_KEY=S...
# Treasury public key that receives settlement fees.
TREASURY_PUBLIC_KEY=G...

# --- KYC provider ---------------------------------------------------------
# `mock` ships with the repo and needs no network access. Swap to `sumsub` or
# `onfido` by implementing the same `IdVerificationProvider` interface; see
# `src/kyc-orchestration/provider.ts`.
KYC_PROVIDER=mock
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_WEBHOOK_SECRET=
# How long an attestation stays valid before the sender must re-verify.
KYC_ATTESTATION_TTL_DAYS=365

# --- Quoting --------------------------------------------------------------
# Basis points of spread over the oracle mid-price.
DEFAULT_SPREAD_BPS=75
# How long a published quote stays valid.
QUOTE_TTL_SECONDS=45
# Key used to sign quotes. The signature is what lets a client prove the rate it
# was shown is the rate the network quoted, without the backend being online.
QUOTE_SIGNING_SECRET_KEY=S...

# --- Indexer --------------------------------------------------------------
# Ledger to start indexing from when the cursor table is empty. `latest` starts
# at the current tip; a number backfills history.
INDEXER_START_LEDGER=latest
INDEXER_POLL_INTERVAL_MS=5000
# Persist raw XDR alongside the normalised read model. Useful for auditing, but
# it is extra storage; set to `false` if retention rules make that awkward.
INDEXER_STORE_RAW_XDR=true

# --- Agent liquidity ------------------------------------------------------
# Alert when an agent's undrawn float falls below this share of its bond (bps).
AGENT_FLOAT_ALERT_BPS=3000
# Alert when a region's pool utilization exceeds this (bps).
POOL_UTILIZATION_ALERT_BPS=7000
# Undrawn reserve the pool must keep before top-ups are recommended.
MIN_POOL_RESERVE_BPS=2000
