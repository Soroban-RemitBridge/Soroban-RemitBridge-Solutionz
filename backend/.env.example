# ---------------------------------------------------------------------------
# RemitBridge backend — copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Postgres holds everything the chain must not: names, documents, screening
# results, travel-rule payloads. Only hashes ever leave this database.
DATABASE_URL=postgresql://remitbridge:remitbridge@localhost:5432/remitbridge?schema=public

# --- Stellar / Soroban ----------------------------------------------------
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Addresses emitted by `scripts/deploy-contracts.ts` into deployed-addresses.json.
CONTRACT_ESCROW=C...
CONTRACT_AGENT_REGISTRY=C...
CONTRACT_COMPLIANCE_HOOK=C...
CONTRACT_LIQUIDITY_POOL=C...

# --- Operator keys --------------------------------------------------------
# SECRETS. Use a secret manager in any real deployment; these two are separated
# deliberately so a compromise of the hot KYC service cannot reconfigure
# compliance thresholds or move network funds.
#
# Attester key: allowed only to publish/revoke attestations.
ATTESTER_SECRET_KEY=S...
# Operator key: can configure corridors, authorize agents, set fees.
OPERATOR_SECRET_KEY=S...
# Treasury public key that receives settlement fees.
TREASURY_PUBLIC_KEY=G...

# --- KYC provider ---------------------------------------------------------
# `mock` is deterministic, holds no external state, and is what CI runs against —
# never what a real deployment runs.
# `http` is the real provider: an HTTP adapter over a vendor's REST API, whose
# request/response contract is documented at the top of
# `src/kyc-orchestration/http-provider.ts`. Switching is a config change; no call
# site moves, because both implement `IdVerificationProvider`.
# `sumsub` / `onfido` stay in the enum so an existing config still validates, but
# they resolve to a named error rather than silently falling back to the mock —
# quietly downgrading a compliance check is not something a typo should do.
KYC_PROVIDER=http
# Required when KYC_PROVIDER=http. The vendor's API root; `/verifications` is
# appended to it.
KYC_PROVIDER_BASE_URL=https://api.your-kyc-vendor.example
# SECRET. Bearer token for the vendor's API.
KYC_PROVIDER_API_KEY=
# SECRET. HMAC-SHA256 key the vendor signs webhooks with. With this unset, every
# webhook is refused — an unsigned webhook is what turns a screening result into
# an on-chain attestation, so "accept unsigned in dev" is not a safe default.
KYC_PROVIDER_WEBHOOK_SECRET=
# How long to wait on the vendor before treating the check as unavailable.
KYC_PROVIDER_TIMEOUT_MS=10000
# How long an attestation stays valid before the sender must re-verify.
KYC_ATTESTATION_TTL_DAYS=365

# --- Quoting --------------------------------------------------------------
# Basis points of spread over the oracle mid-price.
DEFAULT_SPREAD_BPS=75
# How long a published quote stays valid.
QUOTE_TTL_SECONDS=45
# Key used to sign quotes. The signature is what lets a client prove the rate it
# was shown is the rate the network quoted, without the backend being online.
QUOTE_SIGNING_SECRET_KEY=S...

# --- Price source ---------------------------------------------------------
# `horizon` reads the Stellar DEX through Horizon — the executable rate for each
# corridor, followed through whatever path the market uses. This is what a real
# deployment runs; a static rate with no provenance is indistinguishable from a
# stale one, which is why the placeholder labels itself in every quote it emits.
# `static` is a development placeholder for corridors with no market yet.
PRICE_SOURCE=horizon
HORIZON_URL=https://horizon-testnet.stellar.org
# Which Stellar asset each currency trades as, as JSON. Required by
# PRICE_SOURCE=horizon: Horizon prices assets, not currencies, so a currency that
# is absent here cannot be priced and the source refuses rather than guessing.
SDEX_ASSETS={"USD":"USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN","XLM":"native"}

# --- Indexer --------------------------------------------------------------
# Ledger to start indexing from when the cursor table is empty. `latest` starts
# at the current tip; a number backfills history.
INDEXER_START_LEDGER=latest
INDEXER_POLL_INTERVAL_MS=5000
# Persist raw XDR alongside the normalised read model. Useful for auditing, but
# it is extra storage; set to `false` if retention rules make that awkward.
INDEXER_STORE_RAW_XDR=true

# --- Agent liquidity ------------------------------------------------------
# Alert when an agent's undrawn float falls below this share of its bond (bps).
AGENT_FLOAT_ALERT_BPS=3000
# Alert when a region's pool utilization exceeds this (bps).
POOL_UTILIZATION_ALERT_BPS=7000
# Undrawn reserve the pool must keep before top-ups are recommended.
MIN_POOL_RESERVE_BPS=2000
