{
  "name": "@remitbridge/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "RemitBridge deployment tooling: build, deploy and wire the Soroban contracts",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:contracts": "bash ./build-contracts.sh",
    "token:create": "tsx src/create-test-token.ts",
    "deploy": "tsx src/deploy-contracts.ts",
    "deploy:dry-run": "tsx src/deploy-contracts.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/verify-deployment.ts",
    "smoke-test": "tsx src/smoke-test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
