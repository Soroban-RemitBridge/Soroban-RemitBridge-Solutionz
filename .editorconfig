root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,yml,yaml,css,md}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{toml,prisma}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
